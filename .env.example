# Database Configuration
# CHANGE DB_PASSWORD / APP_USER_PASSWORD before any public deployment —
# these are used as-is inside the containers, no other defaults apply.
DB_USER=EDUX
DB_PASSWORD=edux123
DB_URL=oracle-db:1521/EDUX

# Oracle Database (for docker-compose) — APP_USER_PASSWORD must match DB_PASSWORD above.
# Generate strong values with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c20
ORACLE_PASSWORD=oracle123
ORACLE_DATABASE=EDUX
APP_USER=EDUX
APP_USER_PASSWORD=edux123

# Node Environment
NODE_ENV=development

# Next.js
NEXT_TELEMETRY_DISABLED=1

# JWT Configuration
# REQUIRED for production — without it, the app silently falls back to a
# hardcoded, publicly-known secret (see middleware/auth.js). Generate with:
# openssl rand -base64 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production-to-random-string

# AI Configuration
# Set your AI provider: 'openai', 'gemini', or 'local' (for development without API)
AI_PROVIDER=local

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (if using Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# AI Feature Flags (features are ON unless set to 'false')
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_AI_SEARCH=true
ENABLE_AI_SUMMARY=true
ENABLE_AI_QUIZ=true
ENABLE_AI_CHATBOT=true
ENABLE_AI_ANALYTICS=true

# RAG Course Tutor (grounded answers with citations — see docs/RAG.md)
# All optional; defaults shown. Tune with `npm run rag:eval`.
#RAG_CHUNK_SIZE=1100
#RAG_CHUNK_OVERLAP=180
#RAG_TOP_K=5
#RAG_MIN_COSINE=0.2
#RAG_MIN_SCORE=0.015
#RAG_INDEX_CACHE_TTL_MS=300000
#AI_REQUEST_TIMEOUT_MS=30000
#AI_REQUEST_MAX_RETRIES=2

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# ===========================================
# Sentry Error Tracking (Optional)
# ===========================================
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_DEBUG=false

# ===========================================
# PostHog Analytics (Optional)
# ===========================================
# Get your key from https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_DEBUG=false

# ===========================================
# Socket.io Real-time
# ===========================================
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Meilisearch (Optional)
# ===========================================
# Get your key from https://www.meilisearch.com
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# ===========================================
# Redis Cache (Optional)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# PWA / Push Notifications (Optional)
# ===========================================
# Generate VAPID keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@edux.com